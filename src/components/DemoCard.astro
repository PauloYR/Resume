---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  segment: string;
  summary: string;
  tags: string[];
  alt: string;
  url?: string;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const {
  id,
  title,
  segment,
  summary,
  tags,
  alt,
  url,
  featured = false,
  headingLevel: Heading = 'h3',
} = Astro.props;

// Preview image convention: src/assets/demos/<id>-sample.webp
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/demos/*-sample.webp',
  { eager: true },
);
const image = images[`/src/assets/demos/${id}-sample.webp`]?.default;

const Tag = url ? 'a' : 'div';
const linkProps = url
  ? { href: url, target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  {...linkProps}
  class:list={[
    'card reveal group grid content-start gap-5 overflow-hidden p-0',
    featured && 'lg:grid-cols-12 lg:items-center lg:gap-10',
    url &&
      'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
  ]}
>
  {image && (
    <div
      class:list={[
        'overflow-hidden border-b border-line bg-surface-2',
        featured && 'lg:col-span-7 lg:border-r lg:border-b-0',
      ]}
    >
      <Image
        src={image}
        alt={alt}
        widths={[640, 1000, 1400, 2000]}
        quality={90}
        sizes={
          featured
            ? '(min-width: 1280px) 720px, (min-width: 1024px) 58vw, (min-width: 640px) 90vw, 100vw'
            : '(min-width: 1024px) 380px, (min-width: 640px) 45vw, 100vw'
        }
        loading="lazy"
        class="aspect-video h-auto w-full object-cover transition-transform duration-300 ease-out motion-reduce:transition-none group-hover:scale-[1.03]"
      />
    </div>
  )}

  <div
    class:list={[
      'grid content-start gap-3 px-5 pb-5',
      featured && 'lg:col-span-5 lg:py-8 lg:pr-8 lg:pl-0',
    ]}
  >
    <p class="text-sm text-muted">{segment}</p>
    <Heading class="text-[clamp(1.4rem,4.4vw,2rem)] font-semibold">
      {title}
    </Heading>
    <p class="max-w-[52ch] text-muted">{summary}</p>

    <ul class="flex flex-wrap gap-2" aria-label="Tecnologias">
      {tags.map((item) => (
        <li class="rounded-full border border-line bg-surface-2 px-3 py-1 text-sm text-muted">
          {item}
        </li>
      ))}
    </ul>

    {url ? (
      <span class="mt-2 inline-flex min-h-11 items-center gap-2 font-semibold text-accent">
        Ver site ao vivo
        <span class="sr-only"> (abre em nova aba)</span>
        <Icon
          name="arrow"
          class="size-5 transition-transform duration-300 ease-out motion-reduce:transition-none group-hover:translate-x-1"
        />
      </span>
    ) : (
      <span class="mt-2 inline-flex min-h-11 items-center text-muted">
        Link em breve
      </span>
    )}
  </div>
</Tag>

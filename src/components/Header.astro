---
import { site } from '@config/site';
import { isCurrent, nav } from '@lib/nav';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';

interface Props {
  current: string;
}
const { current } = Astro.props;
---

<header class="print:hidden sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur-sm [view-transition-name:site-header]">
  <div class="container-page flex items-center justify-between gap-2 py-2">
    <a
      href="/"
      class="flex min-h-11 items-center gap-2 font-display text-lg font-semibold tracking-tight"
      aria-label={`${site.name}, página inicial`}
    >
      <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
      {site.name}
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(current, item.href) ? 'page' : undefined}
          class="group relative inline-flex min-h-11 items-center px-3 text-[0.95rem] text-muted transition-colors hover:text-fg aria-[current=page]:text-fg"
        >
          {item.label}
          <span
            class="absolute inset-x-3 bottom-1.5 h-0.5 origin-left scale-x-0 bg-accent transition-transform duration-300 ease-out group-aria-[current=page]:scale-x-100 group-hover:scale-x-100"
            aria-hidden="true"
          />
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-palette-open
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K Meta+K"
        class="hidden min-h-11 items-center gap-3 rounded-full border border-line px-4 text-sm text-muted transition-colors hover:border-accent hover:text-fg active:bg-surface-2 md:inline-flex"
      >
        <Icon name="search" class="size-4" />
        Buscar
        <kbd
          data-palette-shortcut
          class="rounded-md border border-line px-1.5 py-0.5 font-sans text-xs"
        >
          Ctrl K
        </kbd>
      </button>
      <ThemeToggle />
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex size-11 items-center justify-center rounded-full border border-line text-fg transition-colors hover:border-accent active:bg-surface-2 md:hidden"
        aria-label="Abrir menu"
      >
        <span class="grid *:col-start-1 *:row-start-1">
          <Icon
            name="menu"
            class="transition-[opacity,transform] duration-300 ease-out motion-reduce:transition-none [[aria-expanded=true]_&]:rotate-90 [[aria-expanded=true]_&]:opacity-0"
          />
          <Icon
            name="close"
            class="-rotate-90 opacity-0 transition-[opacity,transform] duration-300 ease-out motion-reduce:transition-none [[aria-expanded=true]_&]:rotate-0 [[aria-expanded=true]_&]:opacity-100"
          />
        </span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Principal (menu)"
    inert
    class="invisible grid grid-rows-[0fr] bg-bg transition-[grid-template-rows,visibility] duration-300 ease-out motion-reduce:transition-none data-[open]:visible data-[open]:grid-rows-[1fr] md:hidden"
  >
    <ul class="container-page min-h-0 overflow-hidden border-t border-line py-2">
      <li>
        <button
          type="button"
          data-palette-open
          aria-haspopup="dialog"
          class="flex min-h-12 w-full items-center justify-between border-b border-line text-left text-lg text-muted"
        >
          Buscar no site
          <Icon name="search" class="size-4" />
        </button>
      </li>
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(current, item.href) ? 'page' : undefined}
            class="flex min-h-12 items-center justify-between border-b border-line text-lg text-muted transition-colors active:text-fg aria-[current=page]:text-fg"
          >
            {item.label}
            <Icon name="arrow" class="size-4" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const button =
    document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    if (!button || !menu) return;
    if (open) menu.dataset.open = '';
    else delete menu.dataset.open;
    menu.inert = !open;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
  }

  button?.addEventListener('click', () =>
    setOpen(button.getAttribute('aria-expanded') !== 'true'),
  );
  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      button?.getAttribute('aria-expanded') === 'true'
    ) {
      setOpen(false);
      button.focus();
    }
  });
  menu
    ?.querySelectorAll('a, button')
    .forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>

---
import { toChip } from '@lib/tech-icons';
import Gopher from './Gopher.astro';
import TechChip from './TechChip.astro';

interface Props {
  groups: { id: string; label: string; items: string[] }[];
  gopherLines?: string[];
}
const { groups, gopherLines = [] } = Astro.props;
---

<dl class="grid gap-x-12 gap-y-8 md:grid-cols-2">
  {groups.map((group) => (
    <div class="border-t border-line pt-4">
      <dt class="font-display text-lg font-semibold">{group.label}</dt>
      <dd class="mt-3">
        <ul class="flex flex-wrap gap-2">
          {group.items.map((item) => (
            <TechChip chip={toChip(item)} />
          ))}
        </ul>
        {group.id === 'linguagens' && gopherLines.length > 0 && (
          <div class="mt-5">
            <Gopher lines={gopherLines} />
          </div>
        )}
      </dd>
    </div>
  ))}
</dl>

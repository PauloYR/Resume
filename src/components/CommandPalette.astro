---
import { site } from '@config/site';
import { buildCommands } from '@lib/commands';
import { nav } from '@lib/nav';
import Icon from './Icon.astro';

const commands = buildCommands({ nav, site });
---

<dialog
  id="command-palette"
  class="palette m-0 mx-auto mt-[10dvh] mb-auto w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-[0.875rem] border border-line bg-surface p-0 text-fg print:hidden"
  aria-label="Buscar seção ou ação"
  data-commands={JSON.stringify(commands)}
>
  <div class="flex items-center gap-2 border-b border-line pr-2 pl-4">
    <Icon name="search" class="size-5 shrink-0 text-muted" />
    <input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label="Buscar seção ou ação"
      placeholder="Buscar seção ou ação"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      class="min-h-14 min-w-0 flex-1 bg-transparent text-base text-fg placeholder:text-muted focus:outline-none"
    />
    <button
      type="button"
      data-palette-close
      aria-label="Fechar busca"
      class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-muted transition-colors hover:text-fg active:bg-surface-2"
    >
      <Icon name="close" />
    </button>
  </div>
  <ul
    id="palette-list"
    role="listbox"
    aria-label="Resultados"
    class="max-h-[50dvh] overflow-y-auto p-2"
  ></ul>
  <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out motion-reduce:transition-none has-data-[open]:grid-rows-[1fr]">
    <p
      data-palette-empty
      class="invisible min-h-0 overflow-hidden px-4 text-center text-muted opacity-0 transition-[opacity,visibility] duration-300 ease-out motion-reduce:transition-none data-[open]:visible data-[open]:py-6 data-[open]:opacity-100"
    >
      Nada encontrado. Tente "currículo", "tema" ou "github".
    </p>
  </div>
</dialog>

<p
  data-palette-toast
  role="status"
  class="invisible fixed inset-x-4 bottom-4 z-50 mx-auto w-fit max-w-full translate-y-2 rounded-full border border-line bg-surface px-4 py-3 text-sm text-fg opacity-0 transition-[opacity,transform,visibility] duration-300 ease-out motion-reduce:transition-none data-[open]:visible data-[open]:translate-y-0 data-[open]:opacity-100 print:hidden"
></p>

<script>
  import { filterCommands } from '@lib/commands';
  import type { Command } from '@lib/commands';

  const OPTION_CLASS =
    'flex min-h-11 cursor-pointer items-center justify-between gap-3 rounded-lg border-l-2 border-transparent px-3 py-2 text-muted transition-colors duration-150 ease-out motion-reduce:transition-none aria-selected:border-accent aria-selected:bg-surface-2 aria-selected:text-fg';

  function isCommand(value: unknown): value is Command {
    return (
      typeof value === 'object' &&
      value !== null &&
      'id' in value &&
      'label' in value &&
      'kind' in value
    );
  }

  function readCommands(raw: string | undefined): Command[] {
    try {
      const parsed: unknown = JSON.parse(raw ?? '[]');
      return Array.isArray(parsed) ? parsed.filter(isCommand) : [];
    } catch {
      return [];
    }
  }

  const dialog = document.getElementById('command-palette');
  const toast = document.querySelector<HTMLElement>('[data-palette-toast]');
  const input = dialog?.querySelector<HTMLInputElement>('input');
  const list = dialog?.querySelector<HTMLUListElement>('#palette-list');
  const empty = dialog?.querySelector<HTMLElement>('[data-palette-empty]');

  if (dialog instanceof HTMLDialogElement && toast && input && list && empty) {
    const commands = readCommands(dialog.dataset.commands);
    let results: Command[] = commands;
    let active = 0;
    let toastTimer: number | undefined;

    const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
    document
      .querySelectorAll<HTMLElement>('[data-palette-shortcut]')
      .forEach((element) => {
        element.textContent = isMac ? '⌘ K' : 'Ctrl K';
      });

    function showToast(message: string) {
      if (!toast) return;
      toast.textContent = message;
      toast.dataset.open = '';
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        delete toast.dataset.open;
      }, 2400);
    }

    function setActive(index: number) {
      if (!input || !list || results.length === 0) return;
      active = (index + results.length) % results.length;
      list.querySelectorAll('[role="option"]').forEach((option, position) => {
        option.setAttribute('aria-selected', String(position === active));
      });
      const current = list.children[active];
      input.setAttribute('aria-activedescendant', `palette-option-${active}`);
      current?.scrollIntoView({ block: 'nearest' });
    }

    function render() {
      if (!list || !empty || !input) return;
      list.replaceChildren();
      if (results.length > 0) delete empty.dataset.open;
      else empty.dataset.open = '';
      input.removeAttribute('aria-activedescendant');

      results.forEach((command, index) => {
        const option = document.createElement('li');
        option.id = `palette-option-${index}`;
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', 'false');
        option.className = OPTION_CLASS;

        const label = document.createElement('span');
        label.textContent = command.label;
        const hint = document.createElement('span');
        hint.className = 'shrink-0 text-sm text-muted';
        hint.textContent = command.hint;
        option.append(label, hint);

        // Keep focus in the input while clicking an option.
        option.addEventListener('mousedown', (event) => event.preventDefault());
        option.addEventListener('click', () => run(command));
        option.addEventListener('mousemove', () => {
          if (active !== index) setActive(index);
        });
        list.append(option);
      });
      active = 0;
      setActive(0);
    }

    async function copy(value: string) {
      try {
        await navigator.clipboard.writeText(value);
        showToast('E-mail copiado');
      } catch {
        showToast('Não foi possível copiar. Use o link de e-mail no contato.');
      }
    }

    function run(command: Command) {
      if (dialog instanceof HTMLDialogElement) dialog.close();
      if (command.kind === 'theme') {
        document
          .querySelector<HTMLButtonElement>('[data-theme-toggle]')
          ?.click();
      } else if (command.kind === 'copy' && command.value) {
        void copy(command.value);
      } else if (command.kind === 'external' && command.href) {
        window.open(command.href, '_blank', 'noopener,noreferrer');
      } else if (command.kind === 'link' && command.href) {
        window.location.href = command.href;
      }
    }

    function open() {
      if (!(dialog instanceof HTMLDialogElement) || dialog.open || !input)
        return;
      dialog.showModal();
      input.value = '';
      results = commands;
      render();
      input.focus();
    }

    function toggle() {
      if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
      else open();
    }

    input.addEventListener('input', () => {
      results = filterCommands(commands, input.value);
      render();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(active - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const command = results[active];
        if (command) run(command);
      }
    });

    // A click on the backdrop targets the dialog itself (its content fills the box).
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog
      .querySelector('[data-palette-close]')
      ?.addEventListener('click', () => dialog.close());

    document.addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        toggle();
      }
    });

    document
      .querySelectorAll('[data-palette-open]')
      .forEach((button) => button.addEventListener('click', open));
  }
</script>

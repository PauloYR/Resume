---
interface Props {
  id: string;
  title: string;
  intro?: string;
  href?: string;
  linkLabel?: string;
}
const { id, title, intro, href, linkLabel } = Astro.props;
---

<div class="reveal mb-8 flex flex-col gap-3 md:mb-12 md:flex-row md:items-end md:justify-between">
  <div>
    <h2 id={id} class="text-[clamp(2rem,7vw,3.75rem)] font-semibold">
      {title}
    </h2>
    {intro && <p class="mt-3 max-w-[54ch] text-muted">{intro}</p>}
  </div>
  {href && linkLabel && (
    <a
      href={href}
      class="inline-flex min-h-11 items-center gap-2 text-fg underline decoration-accent decoration-2 underline-offset-4 hover:decoration-accent-2"
    >
      {linkLabel}
    </a>
  )}
</div>

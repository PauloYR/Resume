---
// Authored line icons, one stroke weight (1.75), 24px grid. Decorative by default.
interface Props {
  name:
    | 'sun'
    | 'moon'
    | 'menu'
    | 'close'
    | 'github'
    | 'linkedin'
    | 'download'
    | 'arrow'
    | 'mail'
    | 'copy';
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;

const paths: Record<Props['name'], string> = {
  sun: 'M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4M12 8a4 4 0 100 8 4 4 0 000-8z',
  moon: 'M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  github:
    'M9 19c-4 1.2-4-2-6-2.5m12 4.5v-3.1a2.7 2.7 0 00-.8-2.1c2.6-.3 5.3-1.3 5.3-5.8a4.5 4.5 0 00-1.2-3.1 4.2 4.2 0 00-.1-3.1s-1-.3-3.2 1.2a11 11 0 00-5.8 0C6.9 3.6 5.9 3.9 5.9 3.9a4.2 4.2 0 00-.1 3.1A4.5 4.5 0 004.6 10c0 4.5 2.7 5.5 5.3 5.8a2.7 2.7 0 00-.8 2.1V21',
  linkedin:
    'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 2a2 2 0 110 4 2 2 0 010-4z',
  download: 'M12 4v11m0 0l-4-4m4 4l4-4M5 20h14',
  arrow: 'M5 12h14m0 0l-5-5m5 5l-5 5',
  mail: 'M3 6h18v12H3zM3 7l9 7 9-7',
  copy: 'M9 9h10v10H9zM5 15V5h10',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>

---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import { site } from '@config/site';
import { absoluteUrl } from '@lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: readonly object[];
  noindex?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  jsonLd = [],
  noindex = false,
} = Astro.props;
const origin = Astro.site?.toString() ?? 'http://localhost:4321';
const canonical = absoluteUrl(origin, path);
// `build.format: 'file'` makes the pathname `/index.html` / `/projetos.html`.
const cleanPath = path.replace(/\.html$/, '').replace(/\/index$/, '/');
const ogSlug =
  cleanPath === '/'
    ? 'home'
    : cleanPath.replace(/^\//, '').split('/')[0] || 'default';
const ogImage = absoluteUrl(origin, `/og/${ogSlug}.png`);
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="" />
    <meta name="author" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={`${site.name} | Portfólio`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content={`${site.name}, ${site.role} (${site.specialty})`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {jsonLd.map((data) => (
      <JsonLd data={data} />
    ))}

    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-3 focus:text-accent-fg"
    >
      Pular para o conteúdo
    </a>
    <Header current={path} />
    <main id="conteudo" class="container-page">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
  </body>
</html>

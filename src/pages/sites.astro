---
import { getCollection } from 'astro:content';
import { site } from '@config/site';
import { demoUrls } from '@config/demos';
import { withLiveUrl } from '@lib/demos';
import { breadcrumbJsonLd, serviceJsonLd } from '@lib/seo';
import Base from '../layouts/Base.astro';
import DemoCard from '../components/DemoCard.astro';
import Icon from '../components/Icon.astro';

const origin = Astro.site?.toString() ?? 'http://localhost:4321';
const demos = withLiveUrl(
  (await getCollection('demos')).map((entry) => ({
    id: entry.id,
    ...entry.data,
  })),
  demoUrls,
);

const title = `Sites para pequenos negócios | ${site.name}`;
const description =
  'Landing pages rápidas, feitas para aparecer no Google e abrir bem no celular. Veja três exemplos ao vivo e peça um orçamento por e-mail.';

const quoteHref = `mailto:${site.email}?subject=${encodeURIComponent('Orçamento de site')}`;
const included = [
  {
    title: 'Rápido no celular',
    text: 'Páginas estáticas que carregam em segundos, mesmo em 4G.',
  },
  {
    title: 'Aparece no Google',
    text: 'Título, descrição, dados estruturados e mapa do site configurados.',
  },
  {
    title: 'Pronto para contato',
    text: 'Botão de e-mail ou WhatsApp em destaque, sem formulário complicado.',
  },
];
---

<Base
  title={title}
  description={description}
  jsonLd={[
    serviceJsonLd(site, origin, description),
    breadcrumbJsonLd(origin, [
      { name: 'Início', path: '/' },
      { name: 'Sites', path: '/sites' },
    ]),
  ]}
>
  <section class="pt-10 pb-12 md:pt-20" aria-labelledby="titulo">
    <h1
      id="titulo"
      class="max-w-[16ch] text-balance text-[clamp(2.75rem,11vw,6.5rem)] font-bold leading-[0.95]"
    >
      Sites rápidos para o seu <span class="text-brand">negócio</span>
    </h1>
    <p class="mt-6 max-w-[52ch] text-lg text-muted md:text-xl">
      Além do trabalho com backend, crio landing pages para pequenos negócios:
      simples, rápidas e feitas para serem encontradas no Google.
    </p>
    <a
      href={quoteHref}
      class="group mt-8 inline-flex min-h-14 items-center gap-3 rounded-full bg-brand px-8 text-lg font-semibold transition-transform duration-300 ease-out hover:-translate-y-0.5"
    >
      <Icon name="mail" />
      Pedir orçamento
    </a>
  </section>

  <section class="pb-12" aria-labelledby="exemplos">
    <div class="mb-8 md:mb-12">
      <h2 id="exemplos" class="text-[clamp(2rem,7vw,3.75rem)] font-semibold">
        Sites de exemplo
      </h2>
      <p class="mt-3 max-w-[54ch] text-muted">
        Três landing pages que criei como demonstração, com versão desktop e
        mobile. Cada uma abre ao vivo em outra aba.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {demos.map((demo) => (
        <DemoCard {...demo} headingLevel="h3" />
      ))}
    </div>
  </section>

  <section class="pb-12" aria-labelledby="incluso">
    <h2
      id="incluso"
      class="mb-8 text-[clamp(2rem,7vw,3.75rem)] font-semibold md:mb-12"
    >
      O que vem no site
    </h2>
    <ul class="grid gap-6 md:grid-cols-3">
      {included.map((item) => (
        <li class="card reveal grid content-start gap-2 p-5">
          <h3 class="text-xl font-semibold">{item.title}</h3>
          <p class="text-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="py-12 md:py-24" aria-labelledby="orcamento">
    <h2
      id="orcamento"
      class="max-w-[18ch] text-balance text-[clamp(2.4rem,9vw,5rem)] font-bold leading-[0.98]"
    >
      Quer um site assim?
    </h2>
    <p class="mt-4 max-w-[46ch] text-muted">
      Conte o que o seu negócio faz e eu respondo por e-mail com prazo e valor.
    </p>
    <a
      href={quoteHref}
      class="group mt-10 inline-flex min-h-14 items-center gap-3 rounded-full bg-brand px-8 text-lg font-semibold transition-transform duration-300 ease-out hover:-translate-y-0.5"
    >
      <Icon name="mail" />
      Pedir orçamento
    </a>
  </section>
</Base>

---
import { getCollection } from 'astro:content';
import { site } from '@config/site';
import { demoUrls } from '@config/demos';
import { withLiveUrl } from '@lib/demos';
import { breadcrumbJsonLd } from '@lib/seo';
import Base from '../layouts/Base.astro';
import CaseRow from '../components/CaseRow.astro';
import DemoCard from '../components/DemoCard.astro';
import Contact from '../components/Contact.astro';

const origin = Astro.site?.toString() ?? 'http://localhost:4321';
const cases = (await getCollection('cases'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
const demos = withLiveUrl(
  (await getCollection('demos')).map((entry) => ({
    id: entry.id,
    ...entry.data,
  })),
  demoUrls,
);

const title = `Cases e resultados | ${site.name}, backend em Go`;
const description =
  'Quatro cases de backend em Go: motor de pontos a 588 eventos por segundo, assinaturas com PIX e cartão, criptografia com KMS e observabilidade com OpenTelemetry.';
---

<Base
  title={title}
  description={description}
  jsonLd={[
    breadcrumbJsonLd(origin, [
      { name: 'Início', path: '/' },
      { name: 'Cases', path: '/projetos' },
    ]),
  ]}
>
  <section class="pt-10 pb-12 md:pt-20" aria-labelledby="titulo">
    <h1
      id="titulo"
      class="text-[clamp(2.75rem,11vw,6.5rem)] font-bold leading-[0.95]"
    >
      Cases e resultados
    </h1>
    <p class="mt-6 max-w-[52ch] text-lg text-muted md:text-xl">
      Cada case mostra o problema, o que eu fiz e o número que mudou. Todos vêm
      de sistemas em produção numa plataforma financeira.
    </p>
  </section>

  <section class="pb-12" aria-label="Lista de cases">
    {cases.map((item) => (
      <CaseRow {...item} headingLevel="h2" full />
    ))}
  </section>

  <section class="pb-12" aria-labelledby="exemplos">
    <div class="mb-8 md:mb-12">
      <h2 id="exemplos" class="text-[clamp(2rem,7vw,3.75rem)] font-semibold">
        Sites de exemplo
      </h2>
      <p class="mt-3 max-w-[54ch] text-muted">
        Landing pages que criei como demonstração, com versão desktop e mobile.
        São sites estáticos e rápidos, feitos para serem lidos e indexados por
        buscadores como o Google. Cada uma abre ao vivo em outra aba.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {demos.map((demo) => (
        <DemoCard {...demo} headingLevel="h3" />
      ))}
    </div>
  </section>

  <div class="py-12 md:py-24">
    <Contact />
  </div>
</Base>

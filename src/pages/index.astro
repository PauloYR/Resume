---
import { getCollection } from 'astro:content';
import { site } from '@config/site';
import { demoUrls } from '@config/demos';
import { withLiveUrl } from '@lib/demos';
import { personJsonLd, websiteJsonLd } from '@lib/seo';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import CaseRow from '../components/CaseRow.astro';
import DemoCard from '../components/DemoCard.astro';
import CompanyCarousel from '../components/CompanyCarousel.astro';
import ExperienceList from '../components/ExperienceList.astro';
import StackList from '../components/StackList.astro';
import Contact from '../components/Contact.astro';
import GithubActivity from '../components/GithubActivity.astro';
import { getSiteGithubActivity } from '@lib/github-site';
import { buildGopherLines } from '@lib/gopher-lines';
import { buildClientItems, buildCompanyItems } from '@lib/logos';

const origin = Astro.site?.toString() ?? 'http://localhost:4321';

const allCases = (await getCollection('cases'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
const cases = allCases.slice(0, 3);
const demos = withLiveUrl(
  (await getCollection('demos')).map((entry) => ({
    id: entry.id,
    ...entry.data,
  })),
  demoUrls,
);
const gopherLines = buildGopherLines(allCases);
const experience = (await getCollection('experience'))
  .map((entry) => ({ id: entry.id, ...entry.data }))
  .sort((a, b) => b.period.start.localeCompare(a.period.start));
const skills = (await getCollection('skills'))
  .map((entry) => ({
    id: entry.id,
    ...entry.data,
  }))
  .sort((a, b) => a.order - b.order);

const githubActivity = await getSiteGithubActivity();

const companies = buildCompanyItems(experience);
const clients = buildClientItems(
  (await getCollection('clients'))
    .map((entry) => ({ id: entry.id, ...entry.data }))
    .sort((a, b) => a.order - b.order),
  experience,
);

const knowsAbout = skills.flatMap((group) => group.items).slice(0, 24);

const title = `${site.name} | Engenheiro de Software Sênior, Backend em Go`;
const description = `${site.name}, engenheiro de software sênior em Fortaleza-CE: backend em Go, microsserviços, pagamentos e observabilidade. ${site.yearsOfExperience} anos de experiência e motor de pontos com 588 eventos por segundo.`;
---

<Base
  title={title}
  description={description}
  jsonLd={[personJsonLd(site, origin, knowsAbout), websiteJsonLd(site, origin)]}
>
  <Hero />

  <section class="py-12 md:py-20" aria-labelledby="resultados">
    <SectionHead
      id="resultados"
      title="Resultados em produção"
      intro="Números dos sistemas que mantive, com o antes e o depois."
      href="/projetos"
      linkLabel="Ver todos os cases"
    />
    <div class="grid gap-6">
      {cases.map((item) => (
        <CaseRow {...item} />
      ))}
    </div>
  </section>

  <section class="py-12 md:py-20" aria-labelledby="exemplos">
    <SectionHead
      id="exemplos"
      title="Sites de exemplo"
      intro="Três landing pages que criei como demonstração: sites estáticos e rápidos, feitos para serem lidos e indexados por buscadores como o Google."
      href="/projetos#exemplos"
      linkLabel="Ver todos os exemplos"
    />
    <div class="grid gap-6 md:grid-cols-2">
      {demos.map((demo, index) => (
        <div class:list={[index === 0 && 'md:col-span-2']}>
          <DemoCard {...demo} featured={index === 0} />
        </div>
      ))}
    </div>
  </section>

  <section class="py-12 md:py-20" aria-labelledby="empresas">
    <SectionHead id="empresas" title="Onde já trabalhei" />
    <div class="reveal">
      <CompanyCarousel items={companies} label="Empresas onde trabalhei" />
    </div>
    <h3 class="mt-12 mb-6 text-xl font-semibold text-muted md:text-2xl">
      Clientes que atendi
    </h3>
    <div class="reveal">
      <CompanyCarousel items={clients} label="Clientes que atendi" reverse />
    </div>
  </section>

  <section class="py-12 md:py-20" aria-labelledby="trajetoria">
    <SectionHead
      id="trajetoria"
      title="Trajetória"
      intro="De apps Android nativos a microsserviços em Go numa plataforma financeira."
      href="/curriculo"
      linkLabel="Currículo completo"
    />
    <ExperienceList items={experience} />
  </section>

  <section class="py-12 md:py-20" aria-labelledby="stack">
    <SectionHead id="stack" title="O que eu uso" />
    <div class="reveal">
      <StackList groups={skills} gopherLines={gopherLines} />
    </div>
  </section>

  {githubActivity && (
    <section class="py-12 md:py-20" aria-labelledby="github">
      <SectionHead
        id="github"
        title="Atividade no GitHub"
        intro="Contribuições e linguagens dos meus repositórios públicos."
      />
      <div class="reveal">
        <GithubActivity activity={githubActivity} />
      </div>
    </section>
  )}

  <div class="py-12 md:py-24">
    <Contact />
  </div>
</Base>

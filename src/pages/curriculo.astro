---
import { getCollection } from 'astro:content';
import { site } from '@config/site';
import { formatPeriod } from '@lib/format';
import { breadcrumbJsonLd } from '@lib/seo';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/print.css';

const origin = Astro.site?.toString() ?? 'http://localhost:4321';
const experience = (await getCollection('experience'))
  .map((entry) => ({ id: entry.id, ...entry.data }))
  .sort((a, b) => b.period.start.localeCompare(a.period.start));
const skills = (await getCollection('skills'))
  .map((entry) => ({
    id: entry.id,
    ...entry.data,
  }))
  .sort((a, b) => a.order - b.order);
const education = (await getCollection('education')).map((entry) => ({
  id: entry.id,
  ...entry.data,
}));
const certifications = (await getCollection('certifications'))
  .map((entry) => ({
    id: entry.id,
    ...entry.data,
  }))
  .sort((a, b) => a.id.localeCompare(b.id));

const title = `Currículo de ${site.name} | ${site.role}, ${site.specialty}`;
const description = `Currículo de ${site.name}: ${site.yearsOfExperience} anos de experiência, backend em Go, microsserviços, pagamentos e AWS. Baixe em PDF.`;
---

<Base
  title={title}
  description={description}
  jsonLd={[
    breadcrumbJsonLd(origin, [
      { name: 'Início', path: '/' },
      { name: 'Currículo', path: '/curriculo' },
    ]),
  ]}
>
  <div class="resume pb-12">
    <section class="pt-10 pb-6 md:pt-20" aria-labelledby="titulo">
      <h1
        id="titulo"
        class="text-[clamp(2.5rem,10vw,5rem)] font-bold leading-[0.95]"
      >
        {site.name}
      </h1>
      <p class="mt-3 font-display text-xl font-medium text-muted md:text-2xl">
        {site.role} | {site.specialty}
      </p>
      <p class="mt-2 text-sm text-muted">
        {site.city}, {site.region} ·{' '}
        <a
          href={`mailto:${site.email}`}
          class="underline decoration-accent underline-offset-4"
        >
          {site.email}
        </a>{' '}
        ·
        <a
          href={site.linkedin}
          class="underline decoration-accent underline-offset-4"
        >
          linkedin.com/in/pauloyr
        </a>
      </p>

      <div class="mt-8 flex flex-wrap gap-3 print:hidden">
        <a
          href={site.resumePdf}
          download
          class="inline-flex min-h-12 items-center gap-2 rounded-full bg-brand px-6 font-semibold transition-transform duration-300 ease-out hover:-translate-y-0.5"
        >
          <Icon name="download" class="size-5" />
          Baixar PDF
        </a>
        <button
          type="button"
          data-print
          class="inline-flex min-h-12 items-center gap-2 rounded-full border border-line px-6 font-semibold text-fg transition-colors hover:border-accent"
        >
          Imprimir
        </button>
      </div>
    </section>

    <section class="py-6" aria-labelledby="resumo">
      <h2 id="resumo" class="text-2xl font-semibold">
        Resumo profissional
      </h2>
      <p class="mt-3 max-w-[70ch]">{site.summary}</p>
    </section>

    <section class="py-6" aria-labelledby="competencias">
      <h2 id="competencias" class="text-2xl font-semibold">
        Competências
      </h2>
      <dl class="mt-3 grid gap-2">
        {skills.map((group) => (
          <div>
            <dt class="inline font-semibold">{group.label}: </dt>
            <dd class="inline text-muted">{group.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="py-6" aria-labelledby="experiencia">
      <h2 id="experiencia" class="text-2xl font-semibold">
        Experiência profissional
      </h2>
      <div class="mt-3 grid gap-8">
        {experience.map((job) => (
          <article>
            <h3 class="font-display text-lg font-semibold">
              {job.role}
              <span class="font-normal text-muted">
                {' '}
                | {job.company}
                {job.client ? ` (${job.client})` : ''} |{' '}
                {formatPeriod(job.period)} | {job.location}
              </span>
            </h3>
            <p class="mt-1 italic text-muted">{job.summary}</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="py-6" aria-labelledby="formacao">
      <h2 id="formacao" class="text-2xl font-semibold">
        Formação acadêmica
      </h2>
      <ul class="mt-3 grid gap-1">
        {education.map((item) => (
          <li>
            <strong>{item.title}</strong> | {item.school} | {item.years}
          </li>
        ))}
      </ul>
    </section>

    <section class="py-6" aria-labelledby="certificacoes">
      <h2 id="certificacoes" class="text-2xl font-semibold">
        Certificações
      </h2>
      <ul class="mt-3 list-disc space-y-1 pl-5">
        {certifications.map((item) => (
          <li>
            {item.title}
            {item.issuer
              ? ` (${item.issuer}${item.date ? `, ${item.date}` : ''})`
              : ''}
          </li>
        ))}
      </ul>
    </section>

    <section class="py-6" aria-labelledby="idiomas">
      <h2 id="idiomas" class="text-2xl font-semibold">
        Idiomas
      </h2>
      <ul class="mt-3 list-disc space-y-1 pl-5">
        {site.languages.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  document
    .querySelector('[data-print]')
    ?.addEventListener('click', () => window.print());
</script>

# RULES: this file is committed. Names only, NEVER real values.
# Anything sensitive (tokens, keys) is build-time only and must NEVER start with PUBLIC_.

# Production origin used for canonical and sitemap URLs (public, not a secret)
SITE_URL=https://example.com

# GitHub username shown in the activity panel. Optional: defaults to the one in src/config/site.ts
GITHUB_USER=

# Read-only GitHub token used ONLY at build time (src/lib/github.ts) to fetch contributions.
# Secret: set it in CI or your shell, never here. Without it the panel uses src/data/github.json.
GITHUB_TOKEN=

# Live URLs the demo cards open (public, not secrets). Build-time only, https required.
# Empty = the card renders without a link.
DEMO_VETERINARY_URL=
DEMO_LAW_URL=
DEMO_COFFEE_URL=

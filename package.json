{
  "name": "paulo-rocha",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:demo": "DEMO_VETERINARY_URL=http://localhost:4391 DEMO_LAW_URL=http://localhost:4392 DEMO_COFFEE_URL=http://localhost:4393 astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pdf": "node scripts/build-pdf.mjs",
    "secrets:scan": "betterleaks dir . --no-banner --redact",
    "audit": "npm audit --omit=dev --audit-level=high",
    "hooks:test": "node .claude/hooks/selftest.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.60.0",
    "lefthook": "^2.1.16",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-icons": "16.34.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
